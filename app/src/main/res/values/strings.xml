    <!--TERMS AND CONDITIONS-->
    <string name="terms_title">Terms and Conditions</string>
    <string name="terms_intro">MMovies is a free, non-commercial app built as a personal project. By using it, you agree to the following terms.</string>
    <string name="terms_tmdb_attribution_heading">TMDB Attribution</string>
    <string name="terms_tmdb_attribution_body">This product uses the TMDB API but is not endorsed or certified by TMDB.</string>
    <string name="terms_content_ownership_heading">Content Ownership</string>
    <string name="terms_content_ownership_body">All movie and TV show data, images, and related content displayed in this app are sourced from The Movie Database (TMDB) and belong to TMDB and its content providers. MMovies does not own, and makes no claim to, this content.</string>
    <string name="terms_data_accuracy_heading">Data Accuracy</string>
    <string name="terms_data_accuracy_body">Content is provided by TMDB \"as is.\" Neither TMDB nor the developer of this app guarantees that the information shown is accurate, complete, or up to date. Details may be missing, outdated, or incorrect.</string>
    <string name="terms_no_warranty_heading">No Warranty</string>
    <string name="terms_no_warranty_body">MMovies is provided as-is and as-available, without warranty of any kind, express or implied. Use of this app is at your own risk. The developer is not liable for any damages or losses arising from your use of the app.</string>
    <string name="terms_commercial_use_heading">Non-Commercial Use</string>
    <string name="terms_commercial_use_body">This app is not monetized and generates no revenue. It is a personal, non-commercial project and does not sell, sublicense, or redistribute TMDB content or data.</string>
    <string name="terms_changes_heading">Changes to These Terms</string>
    <string name="terms_changes_body">These terms may be updated from time to time. Continued use of the app after changes are made constitutes acceptance of the updated terms.</string>
    <string name="terms_privacy_policy_link">Privacy Policy</string>

    <!--PRIVACY POLICY-->
    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="privacy_policy_intro">MMovies is a free, non-commercial personal project. This policy explains what information the app handles and how.</string>
    <string name="privacy_policy_account_heading">Account Credentials</string>
    <string name="privacy_policy_account_body">When you log in, your TMDB username and password are sent directly to TMDB\'s servers to create a session and are never stored or seen by anyone other than TMDB. You can also use the app as a guest without providing any credentials.</string>
    <string name="privacy_policy_local_storage_heading">Locally Stored Data</string>
    <string name="privacy_policy_local_storage_body">The app stores your TMDB session identifier and account ID on your device to keep you signed in. This data stays on your device and is removed when you log out or clear the app\'s storage.</string>
    <string name="privacy_policy_third_party_heading">Third-Party Services</string>
    <string name="privacy_policy_third_party_body">All movie and TV data, images, and account authentication are provided by The Movie Database (TMDB). Use of TMDB\'s services is subject to TMDB\'s own privacy policy.</string>
    <string name="privacy_policy_no_collection_heading">No Analytics or Tracking</string>
    <string name="privacy_policy_no_collection_body">MMovies does not collect analytics, does not use advertising, and does not share any data with third parties beyond the TMDB requests needed for the app to function.</string>
    <string name="privacy_policy_children_heading">Children\'s Privacy</string>
    <string name="privacy_policy_children_body">This app is not directed at children and does not knowingly collect information from children.</string>
    <string name="privacy_policy_changes_heading">Changes to This Policy</string>
    <string name="privacy_policy_changes_body">This policy may be updated from time to time. Continued use of the app after changes are made constitutes acceptance of the updated policy.</string>

